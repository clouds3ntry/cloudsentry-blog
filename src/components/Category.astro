---
import { cn, sluglify } from '@/utils'

const { name = 'Home', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(currentPath === '/' && name === 'Home')
---

<a
	href={name === 'Home' ? '/' : `/category/${unsluglifyNameCategory}/1`}
	class={cn(
		'px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 border',
		isActive
			? 'bg-[#3B82F6] text-white border-[#3B82F6]'
			: 'bg-[#1E293B] text-[#CBD5E1] border-[#334155] hover:bg-[#334155] hover:text-white'
	)}
>
	{name}
</a>
