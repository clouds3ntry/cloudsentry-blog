---
import { siteConfig } from '@/data/site.config'
import XColorIcon from './icons/XColorIcon.astro'
import LinkedinColorIcon from './icons/LinkedinColorIcon.astro'
const message = siteConfig.shareMessage

const URL = Astro.url.href
---

<div class='space-y-2'>
	<h3 class='font-semibold text-lg text-[#F8FAFC]'>Share</h3>
	<div class='flex gap-3'>
		<a
			href={`https://twitter.com/intent/tweet?text=${message + ' ' + URL}`}
			aria-label='Share on X'
			class='btn-secondary p-3'
			target='_blank'
			rel='noopener noreferrer'
		>
			<XColorIcon />
		</a>
		<a
			href={`https://www.linkedin.com/shareArticle?mini=true&url=${URL}`}
			aria-label='Share on LinkedIn'
			class='btn-secondary p-3'
			target='_blank'
			rel='noopener noreferrer'
		>
			<LinkedinColorIcon />
		</a>
	</div>
</div>
