---
import type { CollectionEntry } from 'astro:content'

import { cn } from '@/utils'
import { Image } from 'astro:assets'

type Props = {
	posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<section class={cn(`flex flex-col md:flex-row sm:justify-between gap-8`)}>
	{
		posts.length > 0 ? (
			posts.map(async (post) => {
				const { remarkPluginFrontmatter } = await post.render()
				return (
					<div class='flex flex-wrap gap-2'>
						<div class='min-h-full'>
							<Image
								src={post.data.heroImage}
								width={200}
								height={200}
								format='webp'
								class='w-16 h-16 object-cover rounded-full'
								alt={`img of ${post.data.title}`}
							/>
						</div>
						<div class='flex flex-col justify-center'>
							<a class='font-medium hover:underline text-[#F8FAFC]' href={`/post/${post.slug}/`}>
								{post.data.title}
							</a>
							<span class='text-sm text-[#94A3B8] mt-1'>{remarkPluginFrontmatter.minutesRead}</span>
						</div>
					</div>
				)
			})
		) : (
			<span class='text-gray-500'>There are no related posts yet. 😢</span>
		)
	}
</section>
